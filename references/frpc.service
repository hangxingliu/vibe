[Unit]
Description=frpc
After=network-online.target
Wants=network-online.target
# Max restart 30 times in 2 hours
StartLimitBurst=30
StartLimitIntervalSec=7200

[Service]
Type=exec
# DynamicUser=yes
Restart=on-failure
RestartSec=15s
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/root/.local/bin/frpc -c /root/.local/etc/frp/frpc.toml

[Install]
WantedBy=multi-user.target
